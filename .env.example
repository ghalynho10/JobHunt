# Copy to .env.local and fill in. Every variable here is parsed by src/env.ts at
# build and at boot, so a missing or malformed one fails loudly rather than
# surfacing later as a confusing runtime error.
#
# For local work you do not need to invent the Supabase values: run
# `pnpm db:start` and the Supabase CLI prints the URL, the publishable key and
# the secret key.
#
# This file is the complete record of what has to be set (spec 0002, invariant
# 7). Nothing here ever carries a real value: .gitignore excludes every .env*
# except this template. The per environment matrix that Vercel holds is in
# docs/specs/0002-deployment-and-environments/index.md.

# --- Supabase (required) ---

NEXT_PUBLIC_SUPABASE_URL=
# The current key format (sb_publishable_...). Safe in the browser.
# The legacy `anon` JWT key is deprecated and is not used anywhere in this project.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The current secret key format (sb_secret_...). Carries BYPASSRLS and skips
# every policy. BINDING RULE 1: only src/lib/supabase/secret.ts may read it.
# Never expose it to the browser and never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=

# --- Site URL (required) ---

# The canonical URL, which is the production origin in every environment,
# including locally. A metadata check run on localhost therefore shows
# production links, which is correct and will look wrong the first time.
# The origin a request is actually served from is resolved separately, in
# src/lib/origin.ts, and the two are never interchangeable.
NEXT_PUBLIC_SITE_URL=https://usejobhunt.dev

# --- Development sign in (optional, defaults to false) ---

# Enables the development only password sign in, in both places it is guarded:
# the sign in page and the Server Action behind it. Set to true locally and on
# Vercel Preview. NEVER set on production: absent means blocked, which is how
# both guards fail closed. Feature 7 deletes the whole feature folder.
DEV_SESSION_ENABLED=true

# Spec 0005. Renders the design system preview at /ui-preview, which is every
# base component at every variant. Safe to set locally and on Vercel Preview;
# absent means the route 404s, which is how it fails closed on production.
UI_PREVIEW_ENABLED=true

# --- Sentry (required on any deployed build, optional locally) ---

# Optional locally and in CI, so a fresh clone still runs before anyone has a
# Sentry project. Required the moment NEXT_PUBLIC_VERCEL_ENV is present, which
# is what stops a deployment shipping with error reporting silently off.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Trace sampling, validated as a number between 0 and 1, defaulting to 1.
# Binding rule 4 needs 1.0 wherever the failure ratio alert runs (production and
# locally). Vercel Preview is set to 0.1 so previews do not compete for quota.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1

# --- Sentry source map upload (optional, build time only) ---
# Read by next.config.ts while bundling, not part of the validated runtime
# surface. Without them the build skips source map upload rather than failing.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Vercel system values (set by Vercel, never set by hand) ---
# NEXT_PUBLIC_VERCEL_ENV, NEXT_PUBLIC_VERCEL_BRANCH_URL and
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA arrive from the "Enable access to System
# Environment Variables" project setting and are parsed as optional in
# src/env.ts. Absent means "not a Vercel deployment", which is the signal the
# conditional Sentry rule and the origin resolver both read.
