# Copy to .env.test. This is what a test run reads (spec 0004, "Configuration
# required"). It is separate from .env.local because src/env.ts validates the
# whole contract on import and the session mint genuinely needs the secret key
# present.
#
# SKIP_ENV_VALIDATION is deliberately NOT the alternative here. It would let a
# run start with SUPABASE_SECRET_KEY undefined and fail later, deep inside the
# mint, which is the silent failure shape the error model exists to prevent.
#
# THE TWO KEYS ARE LEFT BLANK ON PURPOSE, and it is worth saying why, because
# they are genuinely not secrets: they are the Supabase CLI's local development
# keys, identical on every machine, and they reach nothing but a stack running
# on your own laptop. They are still not written here. GitHub's push protection
# recognises the `sb_secret_` prefix and blocks the push, and it is right to. A
# scanner cannot tell a localhost only key from a live one, and neither can the
# next person who reads this file. A repository where that prefix appears in a
# committed file, and everybody has agreed it is fine, is a repository where the
# real one gets committed eventually.
#
# Run `pnpm db:start` and the CLI prints both. `supabase status` prints them
# again later. CI never reads this file: it reads the values straight out of the
# stack it just started, with `supabase status -o env`.

# --- The local Supabase stack (required) ---

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# From `pnpm db:start`, the value printed as PUBLISHABLE_KEY (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# From `pnpm db:start`, the value printed as SECRET_KEY (sb_secret_...).
SUPABASE_SECRET_KEY=

# --- Required by the environment contract ---

# The canonical production origin, in every environment, including a test run.
# Nothing here sends a request to it.
NEXT_PUBLIC_SITE_URL=https://usejobhunt.dev

# --- The session mint (required for the integration project) ---

# Spec 0004, AC-3: the mint fails closed and refuses to create a session unless
# this is explicitly true. A test proves the refusal by re-reading the
# environment with it set to false, so this staying true here is correct.
DEV_SESSION_ENABLED=true

# --- Adzuna (required) ---

# Feature 11, spec 0013. Only the shape has to be real: the suite replays
# recorded fixtures by default (test/helpers/recorder.ts) and never dials
# Adzuna, but src/env.ts validates the whole contract at import regardless of
# what a given run touches. A real pair is needed only to record a fresh
# fixture (TEST_FIXTURE_MODE=record).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Direct database access, LOCAL STACK ONLY (spec 0007) ---

# Read by test/helpers/database.ts, and by nothing the product ships. It is
# deliberately NOT in src/env.ts's contract, because no application module
# connects to Postgres directly and listing it there would imply one does.
#
# It exists because spec 0007's refusal hook is unreachable from the Data API on
# purpose (execute revoked from public, granted to supabase_auth_admin alone),
# so the only honest way to prove its decisions is to call the real function in
# the real database. The helper refuses any host that is not local.
#
# From `pnpm db:start`, the value printed as DB_URL.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# The guard on that connection, and it is deliberately NOT DEV_SESSION_ENABLED.
# Spec 0007 AC-13 says that variable survives with exactly one remaining job,
# guarding the session mint in test/helpers/admin.ts, and src/env.ts's comment
# says the same. A second reader would have made both false. Two guards for two
# different privileged paths also fail independently, which is what you want:
# switching the mint on should not switch on a superuser connection as well.
#
# Defaults to false, so an environment that never sets it is refused.
TEST_DIRECT_DB_ENABLED=true

# --- Record and replay (optional, defaults to replay) ---

# `replay` (the default) reads recorded responses from test/fixtures and never
# touches the network. `record` is an explicit opt in that reaches the real
# service once and overwrites the file. Leave it unset for ordinary runs.
# TEST_FIXTURE_MODE=replay
