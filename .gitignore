# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.playwright-mcp/

# env files (can opt-in for committing if needed)
.env*
# The templates carry no secrets and are the only record of what has to be set.
# .env.test.example is the exception that looks like one: it holds the Supabase
# CLI's fixed local development keys, which are identical on every machine and
# reach nothing but a stack running on localhost.
!.env.example
!.env.test.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent skills: local tooling, not part of the product. Reinstallable from
# skills-lock.json, which stays tracked so the set is still recorded.
/.agents/
/.claude/
